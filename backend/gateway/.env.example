# --- App -----------------------------------------------------------------------
# The gateway must stay on 3000: the Google OAuth callback registered in Google Cloud uses it.
# `next dev` also defaults to 3000, so run the frontend on 3001.
PORT=3000
# Set to `production` in deployed environments: refresh and OAuth-state cookies become `Secure`.
# NODE_ENV=production
# Global route prefix (no leading/trailing slash).
API_PREFIX=api/v1
# Origin of the web client. Used for CORS, email links and the post-OAuth redirect.
FRONTEND_URL=http://localhost:3001
# Whether to trust X-Forwarded-For for the client address (rate limits, session IPs).
# Accepted: false (default, header ignored), a hop count such as 1 (one load balancer in front),
# or true (trust every hop; only safe when the gateway is reachable solely through the proxy).
# Anything else fails startup.
TRUST_PROXY=false
# Five-field cron pattern (default: daily at 03:00) of the purge of expired data: sessions expired
# over 1 day ago, verification tokens spent over 7 days ago, API keys revoked/expired over 90 days ago.
AUTH_CLEANUP_CRON=0 3 * * *
# Rate limits per window: default for every route, auth for login/register/password flows.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# --- Database -----------------------------------------------------------------
# Runtime connection (RLS enforced). Must be the non-owner `app_user` role.
DATABASE_URL=postgresql://app_user:change-me-app@localhost:5432/syntra
# Migration connection: the role that owns the tables (used by script/migrate.ts and drizzle-kit).
DATABASE_MIGRATION_URL=postgresql://syntra:change-me-owner@localhost:5432/syntra
# Password applied to app_user by script/migrate.ts (must match DATABASE_URL).
APP_DB_PASSWORD=change-me-app

# --- Connection pool ----------------------------------------------------------
# Keep (instances x DB_POOL_MAX) below the server's max_connections.
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
DB_SSL=false
DB_APPLICATION_NAME=syntra-gateway

# --- Redis / BullMQ -------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Logical Redis database (0-15). Use a different one to run a second instance with its own queues.
REDIS_DB=0

# --- Authentication -------------------------------------------------------------
# Signing key for access tokens; at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_ISSUER=syntra-gateway
JWT_AUDIENCE=syntra-api
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Days a workspace invitation link stays valid.
INVITATION_TTL_DAYS=7

# --- Google OAuth ---------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials and register the
# callback URL below as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/authentication/callback/google

# --- Mail (SMTP) ----------------------------------------------------------------
# Defaults point at the Mailpit container from docker-compose (UI: http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Syntra <no-reply@syntra.local>
