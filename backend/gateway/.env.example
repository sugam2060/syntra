# --- Database -----------------------------------------------------------------
# Runtime connection (RLS enforced). Must be the non-owner `app_user` role.
DATABASE_URL=postgresql://app_user:change-me-app@localhost:5432/syntra
# Migration connection: the role that owns the tables (used by script/migrate.ts and drizzle-kit).
DATABASE_MIGRATION_URL=postgresql://syntra:change-me-owner@localhost:5432/syntra
# Password applied to app_user by script/migrate.ts (must match DATABASE_URL).
APP_DB_PASSWORD=change-me-app

# --- Connection pool ----------------------------------------------------------
# Keep (instances x DB_POOL_MAX) below the server's max_connections.
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
DB_SSL=false
DB_APPLICATION_NAME=syntra-gateway

# --- Redis / BullMQ (consumed by upcoming queue integration) -------------------
REDIS_HOST=localhost
REDIS_PORT=6379
